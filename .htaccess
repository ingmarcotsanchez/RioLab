# RioLab 4.0 — Apache
Options -Indexes
DirectoryIndex index.php

# Enlaces antiguos de la versión HTML
RedirectMatch 301 ^(.*)/index\.html$ $1/index.php
RedirectMatch 301 ^(.*)/reto\.html$ $1/index.php#retos

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Tamaño máximo de archivos (solo si PHP corre como módulo de Apache;
# con PHP-FPM ajústalo en php.ini o en .user.ini)
<IfModule mod_php.c>
  php_value upload_max_filesize 25M
  php_value post_max_size 26M
</IfModule>
